#version 450
// Write pass of the Y rotation (port of RotoZoomRotateY in
// RotoZoomFunctions.metal); see RotoZoomRotateXClaim.

layout(local_size_x = 8, local_size_y = 8) in;

#include "rotozoom_pc.glsl"
#include "vulkan_common.glsl"

layout(std430, set = 0, binding = 0) writeonly buffer Result { uint result[]; };
layout(std430, set = 0, binding = 1) readonly buffer Src { uint src[]; };
layout(std430, set = 0, binding = 2) readonly buffer Owner { int owner[]; };

void main() {
    uvec2 index = gl_GlobalInvocationID.xy;
    if (index.x >= data.width) return;
    if (index.y >= data.height) return;
    // PixelBufferClass::RotateY: y from the pivot up, then from the pivot - 1
    // down, each SetPixel truncating its float row. The key is that order.
    int y = int(index.y);
    int pivot = int(data.ypivotPx);
    float toy;
    int key;
    if (y >= pivot) {
        toy = data.ysine * float(y - pivot) + data.ypivotPx;
        key = y - pivot;
    } else {
        toy = -1.0 * data.ysine * float(pivot - y) + data.ypivotPx;
        key = int(data.height) + (pivot - 1 - y);
    }
    int toyi = int(toy);
    if (toyi >= 0 && toyi < int(data.height)) {
        uint didx = uint(toyi) * data.width + index.x;
        if (owner[didx] == key) {
            result[didx] = src[index.y * data.width + index.x];
        }
    }
}
