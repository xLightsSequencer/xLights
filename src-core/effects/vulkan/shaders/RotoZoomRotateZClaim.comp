#version 450
// Claim pass of the Z rotation and zoom (port of RotoZoomRotateZClaim in
// RotoZoomFunctions.metal); see RotoZoomRotateXClaim.

layout(local_size_x = 8, local_size_y = 8) in;

#include "rotozoom_pc.glsl"
#include "vulkan_common.glsl"

layout(std430, set = 0, binding = 0) buffer Owner { int owner[]; };

void main() {
    uvec2 index = gl_GlobalInvocationID.xy;
    if (index.x >= data.width) return;
    if (index.y >= data.height) return;
    // PixelBufferClass::RotateZAndZoom: loops x, i, y, j and SetPixel
    // truncates the float destination after a float bounds check. The key is
    // that loop order (the host keeps it within an int).
    int q = int(data.zoomquality);
    int x = int(index.x);
    int y = int(index.y);
    for (int i = 0; i < q; i++) {
        for (int j = 0; j < q; j++) {
            float xx = float(x) + (float(i) * data.zinc) - data.zxoff;
            float yy = float(y) + (float(j) * data.zinc) - data.zyoff;
            float u = data.zxoff + data.zcos * xx * data.zoom + data.zsin * yy * data.zoom;
            if (u >= 0.0 && u < float(data.width)) {
                float v = data.zyoff + -data.zsin * xx * data.zoom + data.zcos * yy * data.zoom;
                if (v >= 0.0 && v < float(data.height)) {
                    uint didx = uint(v) * data.width + uint(u);
                    int key = ((x * q + i) * int(data.height) + y) * q + j;
                    atomicMax(owner[didx], key);
                }
            }
        }
    }
}
