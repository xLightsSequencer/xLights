#version 450
// Claim pass of the X rotation (port of RotoZoomRotateXClaim in
// RotoZoomFunctions.metal). The rotate kernels scatter, so several sources
// can land on one destination; this pass records, per destination, the source
// the CPU loop would write last (atomicMax of its write-order key) and the
// write pass stores only that one. Keeps the output deterministic and equal
// to the CPU render.

layout(local_size_x = 8, local_size_y = 8) in;

#include "rotozoom_pc.glsl"
#include "vulkan_common.glsl"

layout(std430, set = 0, binding = 0) buffer Owner { int owner[]; };

void main() {
    uvec2 index = gl_GlobalInvocationID.xy;
    if (index.x >= data.width) return;
    if (index.y >= data.height) return;
    // PixelBufferClass::RotateX: x from the pivot up, then from the pivot - 1
    // down, each SetPixel truncating its float column. The key is that order,
    // so the claim keeps the source the CPU writes last.
    int x = int(index.x);
    int pivot = int(data.xpivotPx);
    float tox;
    int key;
    if (x >= pivot) {
        tox = data.xsine * float(x - pivot) + data.xpivotPx;
        key = x - pivot;
    } else {
        tox = -1.0 * data.xsine * float(pivot - x) + data.xpivotPx;
        key = int(data.width) + (pivot - 1 - x);
    }
    int toxi = int(tox);
    if (toxi >= 0 && toxi < int(data.width)) {
        uint didx = index.y * data.width + uint(toxi);
        atomicMax(owner[didx], key);
    }
}
